# Cloudinary (required for document upload on /apply/documents)
# 1. Create a free account at https://cloudinary.com
# 2. Copy your "Cloud name" from the dashboard
# 3. Settings -> Upload -> Upload presets -> Add upload preset -> set
#    "Signing Mode" to "Unsigned" -> copy its name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=klwqwtn7
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=teamflow

# Optional — only needed if you wire up the Supabase persistence layer
# described in README.md (the app runs on localStorage without these).
NEXT_PUBLIC_SUPABASE_URL=https://diucpogfjhvojykyoynx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRpdWNwb2dmamh2b2p5a3lveW54Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0MDc2ODMsImV4cCI6MjEwNDk4MzY4M30.GPnVSQz47kfVX9oFjFQQ5FZvPyewvc4yBeGEWA8xLVs

# Required only for permanent account deletion (Settings -> API -> "service_role").
# Server-side only — never prefix with NEXT_PUBLIC_, this key bypasses all
# security rules. Without it, "Delete account" will show an error.

# Optional — real AI interview scoring (see README.md "Setting up AI scoring").
# Server-side only — never prefix this with NEXT_PUBLIC_, or it would ship
# to the browser. Without it, /api/score-interview returns an error and the
# app automatically falls back to the local keyword-matching heuristic.
ANTHROPIC_API_KEY=

# Optional — real flight search + ticketing via Duffel (see README section 8).
# Server-side only. Without it, /api/flights/* returns deterministic demo
# offers and issues a demo booking reference, so the flow still works.
# Use a "duffel_test_..." key while developing.
DUFFEL_API_KEY=

# Optional — real card payment via Stripe Checkout (see README section 8).
# Server-side only — never prefix with NEXT_PUBLIC_. Without it, the booking
# page simulates the payment instead of redirecting to Stripe.
STRIPE_SECRET_KEY=
